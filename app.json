{
  "expo": {
    "name": "Apitool",
    "slug": "apitool-alpha-reactnative",
    "scheme": "apitool",
    "version": "1.0.1",
    "runtimeVersion": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/adaptive-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logos/icon-white-yellow.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F2E4"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir a $(PRODUCT_NAME) usar tu ubicación."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.hoffer.apitool",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/images/logos/icon-white-yellow.png"
    },
    "extra": {
      "apiBaseUrl": "https://api.xn--cabaahoffer-4db.com.ar/",
      "mapTileUrlTemplate": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "mapAttribution": "\u00A9 OpenStreetMap contributors",
      "mapMaximumZ": 19,
      "subscriptionWebUrl": "https://cabanahofferapp.com.ar/suscripcion",
      "revenueCatEntitlement": "Apitool Pro",
      "revenueCatAppleApiKey": "",
      "revenueCatGoogleApiKey": "",
      "eas": {
        "projectId": "08a09d84-4abe-477b-ba0f-6efb2172acf4"
      }
    }
  }
}
